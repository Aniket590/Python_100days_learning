# Type conversion 
# implicit type conversion: Here python automatically convert one data type to another.
# Explicit type conversion: Here we externally order python to convert data type.


# implicit examples

a = 4
b = 3.4
c = 5+7j
print(type(b))
print(type(a))
print(type(c))
print(a+b+c)       # Automatically convert data type
print(b+c)


# Explicit type examples

x = 5.5
print(int(x))

y = 4
print(float(y))

print(complex(y))

