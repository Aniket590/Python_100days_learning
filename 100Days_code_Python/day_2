# Operators:

# Operators are used to perform operation on variables and values. Python has following operators:

#   1. Arithmatic Operators
#   2. Comperision Operators
#   3. Logical Operators
#   4. Bitwise Operators
#   5. Assignment Operators
#   6. Identity Operators
#   7. Membership Operators

# Arithmatic Operators

x = 5
y = 2
print(x + y)

print(x - y)

print(x * y)

print(x/y)

print(x**y)  # x to the power y

print(x%y)   # x modulas y (Give remender)

print(x//y)  # convert quetiont in intezire

# Comperision Operators

print(x > y)

print(x < y)

print(x == y)

print( x != y)

print(x >= y)

print(x <= y)

# Logical Operators

x = True
y = False

print(x or y)

print(x and y)

print(not y)

# Bitwise Operators(convert the no. into binary then perform operations)

x = 2 
y = 3

print(x & y)

print(x | y)  

print(x >> 2)

print(y << 3)

print(~x)

# Assignment Operators (Assigning value to a variable)

a = 3
print(a)

a += 3
print(a)

a -= 3
print(a)

# Identity Operators (check two variale are exist in same meomery location)

a = 3
b = 3
print(a is b)

a = 'hello'
b = 'hello'
print(a is b)

a = [1,2,3]
b = [1,2,3]
print(a is b)

a = "Hello-World"
b = "Hello-World"
print(a is b)


# Membership Operators (Tell one thing lies in other thing)

Remark = "I am doning good"
print("good" in Remark)

N = [1,2,3,4,5]
print(5 in N)